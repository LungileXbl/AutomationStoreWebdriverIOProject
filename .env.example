# Copy this file to .env and fill in the values before running tests locally.
# In CI, set these as repository secrets (see .github/workflows/e2e-wdio.yml).

# Credentials for the registered test account on Automation Test Store
TEST_USER_USERNAME=your_username_here
TEST_USER_PASSWORD=your_password_here

# Base URL of the application under test.
BASE_URL=https://automationteststore.com
